DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-supabase-database-password
DB_HOST=aws-1-your-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Optional for local development; configure these in Render for persistent photos.
# Create a public Supabase Storage bucket, then copy the S3 endpoint, region, and
# server-side access keys from your Supabase Storage settings.
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
